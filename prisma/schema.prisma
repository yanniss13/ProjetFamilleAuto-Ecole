// Schéma de données — MoniteurConnect
// Plateforme d'annonces : les auto-écoles (School) publient des annonces (Listing),
// les moniteurs indépendants postulent (Application) SANS créer de compte.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite en développement (zéro install). En production : passer le provider à
  // "postgresql" et fournir une DATABASE_URL Postgres — aucun changement de code.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Compte auto-école (le seul type d'utilisateur authentifié).
model School {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  businessName String
  siret        String  @unique
  phone        String?

  // Suspension par un administrateur : bloque la connexion et masque les annonces du public.
  suspended Boolean @default(false)

  // Localisation (optionnelle) : adresse saisie par l'école + coordonnées géocodées
  // (Nominatim) pour la carte affichée sur la page détail d'une annonce.
  address   String?
  latitude  Float?
  longitude Float?

  // Vérification d'email + réinitialisation de mot de passe (on stocke des HASH
  // de jetons, jamais les jetons en clair).
  emailVerified     Boolean   @default(false)
  verifyTokenHash   String?   @unique
  verifyTokenExpiry DateTime?
  resetTokenHash    String?   @unique
  resetTokenExpiry  DateTime?

  // Vérification Sirene (Lot F) : statut du SIRET au répertoire, nom officiel et date
  // du dernier contrôle. Jamais bloquant : « unverified » par défaut (comptes existants
  // inclus) ; une panne de l'API est stockée comme « unverified ».
  siretStatus       String    @default("unverified") // "verified" | "not_found" | "closed" | "unverified"
  siretVerifiedName String?
  siretCheckedAt    DateTime?

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Annonce publiée par une auto-école (offre / besoin de moniteur).
model Listing {
  id           Int     @id @default(autoincrement())
  title        String
  description  String
  contractType String? // "cdi" | "cdd" | "freelance" | "apprentissage" (validé applicativement)
  city         String
  department   String  // code département, ex. "13", "75", "2A"
  hoursPerWeek Int?
  compensation String? // texte libre (ex. "à négocier", "2200€ brut/mois")
  status       String  @default("open") // "open" | "closed"

  // Copies en minuscules pour une recherche insensible à la casse, identique sous
  // SQLite (dev) et PostgreSQL (prod). Maintenues par le service à la création/édition.
  titleLower       String?
  descriptionLower String?
  cityLower        String?

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
}

// Candidature d'un moniteur indépendant à une annonce (déposée sans compte).
model Application {
  id             Int     @id @default(autoincrement())
  applicantName  String
  applicantEmail String
  applicantPhone String?
  message        String
  cvPath           String? // chemin relatif du CV (PDF) sous storage/
  idCardPath       String? // chemin relatif de la pièce d'identité (PDF/JPG/PNG) sous storage/
  licensePath      String? // chemin relatif du permis de conduire (PDF/JPG/PNG) sous storage/
  teachingCardPath String? // chemin relatif de la carte/autorisation d'enseigner sous storage/
  status           String  @default("pending") // "pending" | "accepted" | "rejected"

  // Jeton opaque (256 bits, en clair) servant de clé à la page de suivi publique du
  // candidat. Voir docs/superpowers/specs/2026-06-29-lot-b-notifications-suivi-design.md.
  trackingToken String? @unique

  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  contract Contract?

  createdAt DateTime @default(now())

  @@index([listingId])
}

// Contrat généré quand une auto-école accepte une candidature (relation 1‑1).
model Contract {
  id   Int    @id @default(autoincrement())
  type String // "freelance" | "cdi" | "cdd" | "apprentissage" | "generic"

  // Termes saisis par l'école au moment de l'acceptation.
  startDate        DateTime
  endDate          DateTime? // CDD
  motif            String? // motif de recours (CDD)
  grossSalary      String // texte libre : "2200€ brut/mois", "25€/h"…
  weeklyHours      Int?
  trialPeriodWeeks Int?
  workplace        String
  providerSiret    String? // SIRET du prestataire (freelance)
  schoolAddress    String?
  applicantAddress String?
  extraClauses     String?

  // Identité du candidat nécessaire au contrat (saisie par l'école à l'acceptation).
  birthDate              DateTime?
  birthPlace             String?
  nationality            String?
  teachingAuthNumber     String? // n° d'autorisation d'enseigner / carte d'enseignant
  teachingAuthValidUntil DateTime?
  licenseNumber          String? // n° de permis de conduire
  licenseCategories      String? // catégories détenues (ex. "B, A2")

  pdfPath           String // chemin relatif du PDF sous storage/contracts/
  sentToApplicantAt DateTime?

  // Signature électronique (Lot G) : images PNG des signatures sous storage/signatures/,
  // horodatages, et empreintes SHA-256 (preuve d'intégrité entre la signature de l'école
  // et le contreseing du candidat). État dérivé : signé <=> applicantSignedAt non nul.
  schoolSignaturePath    String?
  schoolSignedAt         DateTime?
  applicantSignaturePath String?
  applicantSignedAt      DateTime?
  proposedPdfHash        String? // SHA-256 hex du PDF proposé (signé école seulement)
  signedPdfPath          String? // PDF final contresigné, sous storage/contracts/
  signedPdfHash          String? // SHA-256 hex du PDF final

  applicationId Int         @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Session HTTP persistée (express-session via PrismaSessionStore) : survit aux
// redémarrages, partageable entre processus, identique en SQLite (dev) et PostgreSQL (prod).
model Session {
  sid       String   @id
  data      String // JSON de la session express-session
  expiresAt DateTime

  @@index([expiresAt])
}

// Administrateur de la plateforme (modération). Créé par script CLI, pas en self-service.
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
