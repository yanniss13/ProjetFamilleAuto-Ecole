// Schéma de données — MoniteurConnect (schéma multi-fichiers : un modèle par
// fichier dans ce dossier, Prisma les fusionne — clé "prisma.schema" de
// package.json). Plateforme d'annonces : les auto-écoles (School) publient des
// annonces (Listing), les moniteurs indépendants postulent (Application) SANS
// créer de compte.

generator client {
  // Prisma 7 : générateur "prisma-client" (sans moteur Rust), émission
  // JavaScript CommonJS pour ce projet sans TypeScript. Le client généré vit
  // hors de node_modules et n'est pas versionné (npx prisma generate).
  provider               = "prisma-client"
  output                 = "../../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  // SQLite en développement (zéro install). Depuis Prisma 7, l'URL ne vit plus
  // ici : le CLI la lit dans prisma.config.ts et le client la reçoit via
  // l'adaptateur better-sqlite3 (src/config/prisma.js) — les deux depuis
  // DATABASE_URL, relative à la racine du dépôt ("file:./prisma/dev.db").
  // En production : provider "postgresql" + adaptateur @prisma/adapter-pg.
  provider = "sqlite"
}
