{% extends 'layouts/base.twig' %}

{% block content %}
  <section class="hero">
    {% if status == 'success' %}
      <h1>Adresse confirmée</h1>
      <p>Votre adresse email est confirmée. Vous pouvez maintenant vous connecter.</p>
      <p><a href="/connexion" class="btn btn-primary">Se connecter</a></p>
    {% else %}
      <h1>Lien invalide ou expiré</h1>
      <p>Ce lien de vérification n'est plus valide. Connectez-vous pour recevoir un nouveau lien,
         ou réinscrivez-vous si besoin.</p>
      <p><a href="/connexion" class="btn btn-primary">Connexion</a></p>
    {% endif %}
  </section>
{% endblock %}
