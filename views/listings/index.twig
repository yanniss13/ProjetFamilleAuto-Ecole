{% extends 'layouts/base.twig' %}

{% block content %}
  <div class="page-header"><h1>Annonces</h1></div>

  <form action="/annonces" method="get" class="filter-bar" role="search" aria-label="Filtrer les annonces">
    {% if vue == 'carte' %}<input type="hidden" name="vue" value="carte">{% endif %}
    <div class="filter-field filter-field--wide">
      <label for="f-q">Mot-clé</label>
      <input id="f-q" type="text" name="q" value="{{ filters.q }}" placeholder="poste, ville…">
    </div>
    <div class="filter-field">
      <label for="f-dep">Département</label>
      <input id="f-dep" type="text" name="departement" value="{{ filters.departement }}" inputmode="numeric" placeholder="ex. 13">
    </div>
    <div class="filter-field">
      <label for="f-ville">Autour de</label>
      <input id="f-ville" type="text" name="ville" value="{{ filters.ville }}" placeholder="ville">
    </div>
    <div class="filter-field filter-field--narrow">
      <label for="f-rayon">Rayon</label>
      <select id="f-rayon" name="rayon">
        {% for r in rayons %}
          <option value="{{ r }}" {% if filters.rayon == r %}selected{% endif %}>{{ r }} km</option>
        {% endfor %}
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Filtrer</button>
  </form>

  <div class="listing-toolbar">
    <div class="view-toggle" role="group" aria-label="Affichage">
      <a href="{{ listeUrl }}" class="btn btn-small {% if vue == 'liste' %}btn-primary{% endif %}"{% if vue == 'liste' %} aria-current="page"{% endif %}>Liste</a>
      <a href="{{ carteUrl }}" class="btn btn-small {% if vue == 'carte' %}btn-primary{% endif %}"{% if vue == 'carte' %} aria-current="page"{% endif %}>Carte</a>
    </div>
    <p class="muted listing-toolbar__alert"><a href="{{ alerteUrl }}">Créer une alerte pour cette recherche</a> et recevoir les prochaines annonces par email.</p>
  </div>

  {% if villeIntrouvable %}
    <div class="flash flash-error" role="alert">Ville introuvable — le filtre de rayon a été ignoré.</div>
  {% endif %}

  {% if vue == 'carte' %}
    <div id="listings-map"></div>
    {% if unlocatedCount > 0 %}
      <p class="muted">{{ unlocatedCount }} annonce(s) sans localisation — consultez la vue liste.</p>
    {% endif %}
    {# Bloc de DONNÉES (non exécutable, hors CSP script-src). JSON échappé côté
       serveur ("<" -> séquence unicode) : unique usage documenté de |raw. #}
    <script type="application/json" id="map-data">{{ mapJson|raw }}</script>
  {% else %}
    {% if listings|length == 0 %}
      <p class="muted">Aucune annonce ne correspond à votre recherche.</p>
    {% else %}
      <ul class="listing-list">
        {% for l in listings %}
          {% include 'listings/_card.twig' with { l: l } %}
        {% endfor %}
      </ul>
      {% include 'partials/pagination.twig' %}
    {% endif %}
  {% endif %}
{% endblock %}

{# Assets carto chargés uniquement en vue carte. #}
{% block head %}
  {% if vue == 'carte' %}
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  {% endif %}
{% endblock %}

{% block scripts %}
  {% if vue == 'carte' %}
    <script src="/vendor/leaflet/leaflet.js"></script>
    <script src="/js/listings-map.js"></script>
  {% endif %}
{% endblock %}
