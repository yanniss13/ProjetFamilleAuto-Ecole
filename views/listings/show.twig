{% extends 'layouts/base.twig' %}

{% block content %}
  {# backOfficeSession : posé par sessionLocals sur la session brute, même prédicat
     que rejectBackOfficeApplication — l'affichage suit exactement ce que la route refuse. #}
  <article class="hero">
    <h1>{{ listing.title }}</h1>
    <p class="muted">
      {{ listing.city }} ({{ listing.department }})
      {% if listing.contractType %} · {{ listing.contractType }}{% endif %}
      {% if listing.hoursPerWeek %} · {{ listing.hoursPerWeek }} h/sem{% endif %}
    </p>
    {% if listing.compensation %}<p><strong>Rémunération :</strong> {{ listing.compensation }}</p>{% endif %}
    <p>{{ listing.description }}</p>
    <p class="muted">
      Publiée par {{ listing.school.businessName }}
      {% if listing.school.siretStatus == 'verified' %} <span class="badge-verified">✓ École vérifiée</span>{% endif %}
    </p>
  </article>

  <section class="map-section">
    <h2>Localisation</h2>
    {% if listing.school.latitude %}
      <div id="map"
           data-lat="{{ listing.school.latitude }}"
           data-lng="{{ listing.school.longitude }}"
           data-label="{{ listing.school.businessName }}{% if listing.school.address %} — {{ listing.school.address }}{% endif %}"></div>
    {% else %}
      <p class="muted">Localisation indisponible pour cette auto-école.</p>
    {% endif %}
  </section>

  {% if backOfficeSession %}
    <section class="form-card">
      <h2>Candidature</h2>
      <p class="muted">Les candidatures sont réservées aux moniteurs non connectés à un espace de gestion.</p>
    </section>
  {% else %}
    <section class="form-card">
      <h2>Postuler à cette annonce</h2>
      <form action="/annonces/{{ listing.id }}/postuler"
            method="post" enctype="multipart/form-data" novalidate>
        {# Multipart : le jeton est un champ du formulaire, vérifié après multer. #}
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        {% if errors.files %}<div class="flash flash-error" role="alert">{{ errors.files }}</div>{% endif %}
        <div class="form-group">
          <label for="applicantName">Nom</label>
          <input id="applicantName" name="applicantName" type="text"
                 value="{{ values.applicantName|default('') }}" autocomplete="name" required>
          {% if errors.applicantName %}<p class="field-error">{{ errors.applicantName }}</p>{% endif %}
        </div>

        <div class="form-group">
          <label for="applicantEmail">Email</label>
          <input id="applicantEmail" name="applicantEmail" type="email"
                 value="{{ values.applicantEmail|default('') }}" autocomplete="email" required>
          {% if errors.applicantEmail %}<p class="field-error">{{ errors.applicantEmail }}</p>{% endif %}
        </div>

        <div class="form-group">
          <label for="applicantPhone">Téléphone <span class="muted">(optionnel)</span></label>
          <input id="applicantPhone" name="applicantPhone" type="tel"
                 value="{{ values.applicantPhone|default('') }}" autocomplete="tel">
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required>{{ values.message|default('') }}</textarea>
          {% if errors.message %}<p class="field-error">{{ errors.message }}</p>{% endif %}
        </div>

        <div class="form-group">
          <label for="cv">CV (PDF, 5 Mo max)</label>
          <input id="cv" name="cv" type="file" accept="application/pdf" required>
          {% if errors.cv %}<p class="field-error">{{ errors.cv }}</p>{% endif %}
        </div>

        <div class="form-group">
          <label for="idCard">Pièce d'identité (PDF, JPG ou PNG, 5 Mo max)</label>
          <input id="idCard" name="idCard" type="file" accept="application/pdf,image/jpeg,image/png" required>
          {% if errors.idCard %}<p class="field-error">{{ errors.idCard }}</p>{% endif %}
          <p class="muted">Recto/verso de votre carte d'identité, passeport ou titre de séjour.</p>
        </div>

        <div class="form-group">
          <label for="license">Permis de conduire (PDF, JPG ou PNG, 5 Mo max)</label>
          <input id="license" name="license" type="file" accept="application/pdf,image/jpeg,image/png" required>
          {% if errors.license %}<p class="field-error">{{ errors.license }}</p>{% endif %}
        </div>

        <div class="form-group">
          <label for="teachingCard">Carte d'enseignant / autorisation d'enseigner (PDF, JPG ou PNG, 5 Mo max)</label>
          <input id="teachingCard" name="teachingCard" type="file" accept="application/pdf,image/jpeg,image/png" required>
          {% if errors.teachingCard %}<p class="field-error">{{ errors.teachingCard }}</p>{% endif %}
        </div>

        <button type="submit" class="btn btn-primary">Envoyer ma candidature</button>
      </form>
    </section>
  {% endif %}

  <p class="form-footer"><a href="/annonces">Retour aux annonces</a></p>
{% endblock %}

{# Assets carto chargés uniquement quand l'école a des coordonnées. #}
{% block head %}
  {% if listing.school.latitude %}
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  {% endif %}
{% endblock %}

{% block scripts %}
  {% if listing.school.latitude %}
    <script src="/vendor/leaflet/leaflet.js"></script>
    <script src="/js/listing-map.js"></script>
  {% endif %}
{% endblock %}
