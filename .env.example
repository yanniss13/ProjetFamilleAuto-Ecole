# Base de données (SQLite en dev ; trajectoire PostgreSQL : docs/jury/base-de-donnees.md)
DATABASE_URL="file:./dev.db"

# Secret de session (OBLIGATOIRE — longue chaîne aléatoire)
SESSION_SECRET="change-me-with-a-long-random-string"

# Port HTTP
PORT=3000

# Environnement : "production" active cookies secure (HTTPS) + trust proxy
NODE_ENV=development

# URL publique (utilisée dans les liens des emails de vérification / réinitialisation)
APP_URL="http://localhost:3000"

# SMTP (envoi des emails). Si SMTP_HOST est vide => mode dev : les liens sont
# affichés dans la console au lieu d'être envoyés (pratique pour tester sans serveur mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MoniteurConnect <no-reply@moniteur-connect.local>"
